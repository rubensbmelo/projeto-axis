SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000

# --- Hardening de produção ---
# Origens permitidas no CORS (separadas por vírgula). Em produção, liste o
# domínio do frontend (ex: https://axis.app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limiting (requisições por 15 min por IP)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=30      # onboarding/criação de organização
RATE_LIMIT_UPLOAD=30    # upload de documentos
# Tamanho máximo de upload em MB
DOC_UPLOAD_MAX_MB=15
# Definir como 1 quando rodar atrás de proxy reverso (Render/Railway/etc.)
TRUST_PROXY=0
