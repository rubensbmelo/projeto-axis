# ============================================================
# AXIS — variáveis de produção (NUNCA commitar valores reais)
# Copie para .env.production e preencha.
# ============================================================

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domínio da aplicação (sem https://)
SITE_ADDRESS=axis.seudominio.com

# CORS: apenas o domínio do frontend de produção
CORS_ORIGINS=https://axis.seudominio.com

# Rate limiting (req / 15 min por IP)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=30
RATE_LIMIT_UPLOAD=30
DOC_UPLOAD_MAX_MB=15

# Rodando atrás do proxy (Caddy) → confiar no proxy p/ IP real
TRUST_PROXY=1

# Build do frontend (mesmos valores do Supabase acima)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
